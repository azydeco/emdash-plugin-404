---
/**
 * The site drops this into its `404.astro`, wrapping its own 404 markup in
 * the default slot as the fallback. The response is a genuine 404 with the
 * fixed SEO and caching headers whether or not the plugin is enabled; only
 * the body changes.
 *
 * The site's `404.astro` must also call `markNotFound(Astro.response)` in
 * its own frontmatter. Astro copies the response headers once the page's
 * frontmatter has run and streams the rest, so by the time this component's
 * frontmatter runs the headers below are already sent; the call here only
 * takes effect when the page is not streamed.
 *
 * The config is read by in-process dispatch to the plugin's public `config`
 * route (see `loadCustom404`), never by HTTP.
 *
 * Never import `emdash/middleware` here: it pulls in `astro:` virtual
 * modules that break config evaluation.
 */
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import { Image } from "emdash/ui";
import { markNotFound } from "../not-found-response";
import { loadCustom404 } from "../page-model";

markNotFound(Astro.response);

const page = await loadCustom404(getPublicPluginApiRouteHandler(Astro.locals));
---

{page ? (
	<div class={`custom-404-page custom-404-page--placement-${page.placement}`}>
		{page.image && (
			<figure class="custom-404-page__image">
				<Image image={page.image.value} alt={page.image.alt} />
			</figure>
		)}
		<div class="custom-404-page__content">
			<h1 class="custom-404-page__heading">{page.headline}</h1>
			{page.paragraphs.map((paragraph) => (
				<p class="custom-404-page__paragraph">{paragraph}</p>
			))}
			{page.cta && (
				<a class="custom-404-page__cta" href={page.cta.href}>
					{page.cta.label}
				</a>
			)}
		</div>
	</div>
) : (
	<slot />
)}

<style is:global>
	/*
	 * Layout only. Colours and fonts are inherited from the site. The
	 * `custom-404-page` class names are the documented override surface, so
	 * every selector is wrapped in `:where()` for zero specificity and a
	 * site's own rules always win. Global rather than scoped: Astro's default
	 * `attribute` scoping adds a `[data-astro-cid-*]` selector, which would
	 * outrank a site's plain class override.
	 */
	:where(.custom-404-page) {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	:where(.custom-404-page--placement-below) {
		flex-direction: column-reverse;
	}

	:where(.custom-404-page--placement-left) {
		flex-direction: row;
		align-items: flex-start;
	}

	:where(.custom-404-page--placement-right) {
		flex-direction: row-reverse;
		align-items: flex-start;
	}

	@media (max-width: 639px) {
		:where(
			.custom-404-page--placement-left,
			.custom-404-page--placement-right
		) {
			flex-direction: column;
		}
	}

	:where(.custom-404-page__image) {
		margin: 0;
		flex: 0 1 auto;
		max-width: 24rem;
	}

	:where(.custom-404-page__image img) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	:where(.custom-404-page__content) {
		flex: 1 1 0;
		min-width: 0;
	}
</style>
