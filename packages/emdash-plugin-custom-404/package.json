{
	"name": "@azydeco/emdash-plugin-custom-404",
	"version": "0.1.0",
	"description": "Native EmDash plugin that lets editors configure the site's 404 page from the admin and serves it with a genuine 404 status.",
	"type": "module",
	"license": "MIT",
	"files": [
		"src"
	],
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx",
		"./astro": "./src/astro/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro",
		"404"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@emdash-cms/admin": ">=0.37.0",
		"astro": ">=7.0.0",
		"emdash": ">=0.37.0",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"devDependencies": {
		"@emdash-cms/admin": "0.37.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"astro": "catalog:",
		"emdash": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
