{
	"name": "@azydeco/emdash-plugin-custom-404",
	"version": "0.1.1",
	"description": "Native EmDash plugin that lets editors configure the site's 404 page from the admin and serves it with a genuine 404 status.",
	"keywords": [
		"404",
		"astro",
		"emdash",
		"emdash-plugin"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/azydeco/emdash-plugin-404.git",
		"directory": "packages/emdash-plugin-custom-404"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/test-support.ts",
		"!src/astro/tsconfig.json"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx",
		"./astro": "./src/astro/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@emdash-cms/admin": "catalog:",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"astro": "catalog:",
		"emdash": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@emdash-cms/admin": ">=1.0.0",
		"astro": ">=7.0.0",
		"emdash": ">=1.0.0",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	}
}
