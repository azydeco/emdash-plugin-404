{
	// Node scripts, run as .ts by Node's type stripping. Kept apart from the
	// plugin's tsconfig so Node's globals never leak into the workerd source.
	"compilerOptions": {
		"target": "ES2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		// Type stripping only erases annotations; it can't compile enums,
		// namespaces or parameter properties, or tell type imports apart.
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["./**/*.ts"]
}
