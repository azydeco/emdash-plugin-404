{
	"name": "azdeco-404-workspace",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "pnpm -r --if-present --parallel run dev",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm -r --if-present run test",
		"lint": "oxlint --type-aware --deny-warnings",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt && prettier --write \"**/*.astro\"",
		"format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2003",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.1.0"
	},
	"lint-staged": {
		"*.astro": "prettier --write",
		"*": [
			"oxfmt --no-error-on-unmatched-pattern",
			"pnpm lint --no-error-on-unmatched-pattern"
		]
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.1",
			"onFail": "download"
		}
	}
}
