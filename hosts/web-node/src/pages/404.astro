---
import {
	Custom404,
	markNotFound,
} from "@azydeco/emdash-plugin-custom-404/astro";
import Base from "../layouts/Base.astro";

// Page-level, not only inside the component: under streaming Astro sends the
// response headers once this frontmatter has run, before the component's
// frontmatter can set them. See the docblock in Custom404.astro.
markNotFound(Astro.response);
---

<Base title="Page not found">
	<div class="wrapper-404">
		<Custom404>
			<div class="not-found">
				<h1>404</h1>
				<p>The page you're looking for doesn't exist.</p>
				<a href="/">Go back home..</a>
			</div>
		</Custom404>
	</div>
</Base>

<style>
	.wrapper-404 {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 50vh;
	}

